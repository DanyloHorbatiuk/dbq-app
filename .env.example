# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL superuser (container bootstrap only) ------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_PORT=5432

# --- Application roles ------------------------------------------------------
# saw_admin    — owns the museum schema, runs index experiments
# saw_readonly — executes every user-facing query, SELECT only
SAW_ADMIN_USER=saw_admin
SAW_ADMIN_PASSWORD=
SAW_READONLY_USER=saw_readonly
SAW_READONLY_PASSWORD=

# --- Business role (SPEC.md §2.2.5) ------------------------------------------
# museum_manager — SELECT-only role for a human museum manager, not used by
# the API itself (that's saw_readonly's job).
MUSEUM_MANAGER_USER=museum_manager
MUSEUM_MANAGER_PASSWORD=

# --- Databases --------------------------------------------------------------
MUSEUM_DB=museum
DVDRENTAL_DB=dvdrental

# --- API --------------------------------------------------------------------
API_PORT=8000
STATEMENT_TIMEOUT_MS=15000
DEFAULT_ROW_LIMIT=1000
BENCHMARK_DEFAULT_RUNS=10
LOG_LEVEL=info

# --- Host uid/gid for the ./reports bind mount (Linux only) -----------------
# On Linux, the api container's own uid:gid (10001:10001) is almost never
# what owns a freshly cloned ./reports/ on the host, so benchmark and
# experiment runs — which write there — fail with PermissionError even
# though plain query execution (which doesn't write) works fine. Setting
# these to your own uid:gid fixes it: run `id -u` / `id -g` and paste the
# numbers below. Safe to leave unset (defaults to 10001:10001, i.e. no
# change) — Docker Desktop on macOS/Windows generally doesn't hit this.
HOST_UID=
HOST_GID=

# --- pgAdmin (profile: tools) ----------------------------------------------
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
